{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "sdlc-orchestrator",
  "share": "disabled",
  "permission": {
    "edit": "allow",
    "bash": "ask",
    "webfetch": "ask"
  },
  "agent": {
    "sdlc-orchestrator": {
      "mode": "primary",
      "description": "Coordinates end-to-end engineering work and delegates to specialist agents.",
      "model": "YOUR_HIGH_PROVIDER/YOUR_HIGH_MODEL_ID",
      "temperature": 0.2,
      "steps": 40,
      "permission": {
        "edit": "allow",
        "bash": "ask",
        "webfetch": "ask"
      }
    }
  }
}
